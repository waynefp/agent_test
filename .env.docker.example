# Docker Environment Variables
# Copy this file to .env and fill in your actual values

# REQUIRED: Your Anthropic API key
ANTHROPIC_API_KEY=sk-ant-your-key-here

# OPTIONAL: Perplexity API key for web search tool
PERPLEXITY_API_KEY=pplx-your-key-here

# OPTIONAL: n8n MCP integration
# Enables agent to call n8n workflows as tools
N8N_API_TOKEN=your-n8n-api-token-here
N8N_SERVER_URL=https://n8n.srv1063345.hstgr.cloud/mcp-server/http

# Port (default: 3000)
# PORT=3000

# Node environment
# NODE_ENV=production

# Shared secret for the HTTP API. REQUIRED — without it every route except
# /health returns 503. Callers send it as an `x-api-key` header (in n8n, an
# httpHeaderAuth credential). Generate one with:  openssl rand -hex 32
AGENT_API_KEY=
