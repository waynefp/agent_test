# Anthropic API Configuration
# Get your API key from: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=your_api_key_here

# Model Configuration (Optional - these have defaults)
# ANTHROPIC_MODEL=claude-sonnet-4-5-20250929
# MAX_TOKENS=8192  # Max output tokens (increased for document generation)

# Data Storage Paths (Optional - defaults to ./data)
# CONVERSATIONS_DIR=./data/conversations
# TASKS_DIR=./data/tasks

# Logging (Optional - defaults to 'info')
# LOG_LEVEL=debug  # Options: debug | info | warn | error

# Extended Thinking (Phase 16) - Optional
# Controls step-by-step reasoning before responses
# THINKING_ENABLED=false         # Off by default (saves costs/latency)
# THINKING_BUDGET_TOKENS=10000   # Token budget for reasoning (1K-100K)

# Web Search Provider (Optional)
# Get your API key from: https://www.perplexity.ai/settings/api
# If not set, falls back to DuckDuckGo (limited results)
# PERPLEXITY_API_KEY=pplx-your_api_key_here
